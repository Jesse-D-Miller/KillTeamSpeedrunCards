{
  "name": "killteamspeedruncards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,table -c cyan,green \"vite\" \"nodemon --watch server --watch shared --ext js --ignore server/data --exec \\\"KT_SERVE_STATIC=0 node server/index.js\\\"\"",
    "dev:web": "vite",
    "dev:server": "KT_SERVE_STATIC=0 node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "table": "vite build && node server/index.js",
    "lint": "eslint .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "seed:stats": "node scripts/seedHistory.mjs",
    "dev:stats-sample": "npm run seed:stats && KT_HISTORY_FILE=server/data/history.sample.json npm run dev"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "nodemon": "^3.1.4",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
